# LLM chain (any one is enough; more = resilience). See llm.py.
NIM_API_KEY=xxxx
GROQ_API_KEY=xxxx
OPENROUTER_API_KEY=xxxx
# OLLAMA_URL=http://127.0.0.1:11434     # local fallback; workflow sets this in CI

# Footage (optional but recommended -- keyless Archive.org/Wikimedia/NASA always work)
PEXELS_API_KEY=xxxx
PIXABAY_API_KEY=xxxx

# Reddit official API (recommended: live vote counts drive story selection)
REDDIT_CLIENT_ID=xxxx
REDDIT_CLIENT_SECRET=xxxx

# YouTube (per channel; run get_youtube_token.py signed in as each channel)
YT_CLIENT_ID=xxxx
YT_CLIENT_SECRET=xxxx
YT_REFRESH_TOKEN_KINDLING=xxxx
YT_REFRESH_TOKEN_DRIFTWATER=xxxx

# TikTok via Buffer (posts publicly with caption through Buffer's approved app)
BUFFER_ACCESS_TOKEN=xxxx
BUFFER_CHANNEL_ID_KINDLING=xxxx
BUFFER_CHANNEL_ID_DRIFTWATER=xxxx

# OPENMONTAGE_DIR=./OpenMontage         # where the OpenMontage checkout lives
# DRY_RUN=1                             # render without uploading
# CHANNELS=kindling                     # run a subset
